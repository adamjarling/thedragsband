---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'de' as const;

const shows = (await getCollection('shows')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);
const now = new Date();
const upcoming = shows.filter((s) => s.data.date >= now);
const past = shows.filter((s) => s.data.date < now).reverse();

const videos = await getCollection('videos');
const tracks = await getCollection('tracks');
const gallery = await getCollection('gallery');
---

<BaseLayout
  lang={lang}
  title="The Drags"
  description="The Drags – Blues Garage Rock aus Wien, Österreich."
  canonicalUrl="https://www.thedragsband.com/"
>
  <main class="gutter" style="padding-block: 40px;">
    <h1 class="display" style="font-size: 44px;">Foundation smoke test</h1>

    <p style="margin-top: 16px;">
      shows: {shows.length} ({upcoming.length} upcoming, {past.length} past) ·
      videos: {videos.length} · tracks: {tracks.length} · gallery: {gallery.length}
    </p>

    <ul style="margin-top: 20px; list-style: none;">
      {shows.map((s) => (
        <li class="label" style="margin-bottom: 6px;">
          {s.data.date.toISOString().slice(0, 10)} — {s.data.venue}
          {s.data.flyer ? ' · flyer' : ' · PLATE'}
          {s.data.date >= now ? ' · UPCOMING' : ' · past'}
        </li>
      ))}
    </ul>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; max-width: 700px;">
      {gallery.slice(0, 3).map((p) => (
        <div class="frame" style="aspect-ratio: 3/4;">
          <Image src={p.data.src} alt={p.data.alt} width={600} class="photo" />
        </div>
      ))}
      {shows.filter((s) => s.data.flyer).map((s) => (
        <div class="frame" style="aspect-ratio: 3/4;">
          <Image src={s.data.flyer!} alt={s.data.flyerAlt ?? ''} width={400} style="width:100%;height:100%;object-fit:cover;" />
        </div>
      ))}
      <div class="plate frame" style="aspect-ratio: 3/4; display: grid; place-items: center;">
        <span class="label">PLATE</span>
      </div>
    </div>
  </main>
</BaseLayout>
