---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  lang?: 'de' | 'en';
  description?: string;
  canonicalUrl?: string;
  ogImage?: 'og-poster.png' | 'og-pasteup.png' | 'og-show.png';
}

const {
  title = 'The Drags',
  lang = 'de',
  description = 'The Drags – Blues Garage Rock aus Wien.',
  canonicalUrl = 'https://thedragsband.com/',
  ogImage: ogImageFile = 'og-pasteup.png',
} = Astro.props;

const ogImage = `https://thedragsband.com/${ogImageFile}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Theme must be resolved BEFORE first paint or light-theme
         visitors get a black flash on every load. Deliberately does
         not consult prefers-color-scheme: the band wants dark first. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('drags-theme');
          document.documentElement.dataset.theme =
            stored === 'light' || stored === 'dark' ? stored : 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    <link rel="icon" type="image/x-icon" href="/favicon_io/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#17190f" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'de' ? 'de_AT' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_AT'} />
    <meta property="og:site_name" content="The Drags" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Alternate language links -->
    {lang === 'de' && <link rel="alternate" hreflang="en" href="https://thedragsband.com/en/" />}
    {lang === 'en' && <link rel="alternate" hreflang="de" href="https://thedragsband.com/" />}
    <link rel="alternate" hreflang="x-default" href="https://thedragsband.com/" />

    <!-- MusicGroup structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'MusicGroup',
        name: 'The Drags',
        description: 'Blues Garage Rock band from Vienna, Austria.',
        url: 'https://thedragsband.com',
        image: ogImage,
        genre: ['Blues', 'Garage Rock'],
        foundingLocation: { '@type': 'Place', name: 'Vienna, Austria' },
      })}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
