---
import { Image } from 'astro:assets';
import platePhoto from '../assets/photos/mobile-hero-bg1.png';
import SectionHead from './SectionHead.astro';
import {
  useTranslations, formatShowDate, formatTime, formatPlateDate, type Lang,
} from '../i18n/utils';
import { pick } from '../i18n/localized';
import { photographers } from '../data/lineup';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  upcoming: CollectionEntry<'shows'>[];
  past: CollectionEntry<'shows'>[];
}
const { lang, upcoming, past } = Astro.props;
const t = useTranslations(lang);

/* Tilt alternates per row so the stack never reads as uniform. */
const tilt = (i: number) => (i % 2 === 0 ? 'rotate(-1deg)' : 'rotate(1deg)');

function dateLine(show: CollectionEntry<'shows'>) {
  const d = show.data;
  const base = `${formatShowDate(d.date, lang)}`;
  if (d.doors) {
    return `${base} · ${t.shows.doors.toUpperCase()} ${formatTime(d.doors, lang)} · ${t.shows.show.toUpperCase()} ${formatTime(d.date, lang)}`;
  }
  return `${base} · ${formatTime(d.date, lang)}`;
}

const posterArtist = (show: CollectionEntry<'shows'>) =>
  show.data.flyerCredit ? photographers[show.data.flyerCredit] : null;

/* One flat list drives the stack, with two non-show markers in it: `slot` is
   where Home drops the radio feature (right under the upcoming gigs, so the
   next show stays the lead), and `pastHead` is the divider that opens the
   past group. `n` counts real shows only, so the tilt still alternates. */
type Row =
  | { kind: 'show'; show: CollectionEntry<'shows'>; isPast: boolean; n: number }
  | { kind: 'slot' }
  | { kind: 'pastHead' };

const rows: Row[] = [
  ...upcoming.map((show, n): Row => ({ kind: 'show', show, isPast: false, n })),
  { kind: 'slot' },
  ...(past.length ? [{ kind: 'pastHead' } as Row] : []),
  ...past.map((show, n): Row => ({ kind: 'show', show, isPast: true, n: upcoming.length + n })),
];
---

<section class="shows gutter" id="shows">
  <SectionHead
    title={t.shows.heading}
    meta={`${upcoming.length} ${t.shows.upcoming}`}
  />

  {upcoming.length === 0 && <p>{t.shows.none}</p>}

  <div class="shows__stack">
    {rows.map((row) => {
      if (row.kind === 'slot') return <slot name="between" />;
      if (row.kind === 'pastHead') {
        return (
          <div class="shows__group" role="presentation">
            <span class="label shows__group-label">{t.shows.past}</span>
            <span class="shows__group-rule" aria-hidden="true"></span>
          </div>
        );
      }
      const { show, isPast, n: i } = row;
      return (
      <article class:list={['show', 'frame', isPast && 'show--past']}>
        <div class="show__art" style={`transform:${tilt(i)}`}>
          {isPast && <span class="show__stamp label" aria-hidden="true">{t.shows.past}</span>}
          {show.data.flyer ? (
            /* Flyers stay in full colour — no greyscale filter here.
               The image itself opens the lightbox, like the Flyer button. */
            <button
              type="button"
              class="show__flyer-btn"
              data-flyer-zoom
              data-flyer
              data-flyer-src={show.data.flyer.src}
              data-flyer-alt={pick(show.data.flyerAlt, lang) ?? show.data.venue}
              data-flyer-credit={posterArtist(show)?.name ?? ''}
              data-flyer-credit-url={posterArtist(show)?.url ?? ''}
              aria-label={`${t.shows.flyer}: ${pick(show.data.flyerAlt, lang) ?? show.data.venue}`}
            >
              <Image
                src={show.data.flyer}
                alt={pick(show.data.flyerAlt, lang) ?? show.data.venue}
                width={300}
                widths={[300, 600, 900, 1200]}
                sizes="(max-width: 780px) 100vw, 150px"
                class:list={['show__flyer', 'frame', show.data.flyerFit === 'contain' && 'show__flyer--contain']}
              />
            </button>
          ) : (
            /* Standing pattern for dates announced before artwork exists. */
            <div class="show__plate plate frame">
              <Image
                src={platePhoto}
                alt=""
                aria-hidden="true"
                width={400}
                loading="lazy"
                class="show__plate-bg"
              />
              <span class="show__plate-date">{formatPlateDate(show.data.date, lang)}</span>
              <span class="display show__plate-city">{pick(show.data.plateCity, lang) ?? pick(show.data.city, lang)}</span>
            </div>
          )}
        </div>

        <div class="show__body">
          <p class="show__date">{dateLine(show)}</p>
          <h3 class="display show__venue">{show.data.venue}</h3>
          <p class="show__meta">
            {pick(show.data.city, lang)}{show.data.support ? ` · ${pick(show.data.support, lang)}` : ''}
          </p>
          <p class="show__meta">{pick(show.data.policy, lang) ?? t.shows.policy}</p>
        </div>

        <div class="show__actions">
          {show.data.ticketUrl && !isPast && (
            <a href={show.data.ticketUrl} target="_blank" rel="noopener noreferrer" class="show__btn show__btn--fill label">
              {t.shows.tickets}
            </a>
          )}
          {/* A finished broadcast becomes a recording: point at the radio card. */}
          {show.data.type === 'radio' && isPast && (
            <a href="#radio" class="show__btn show__btn--fill label">
              {t.shows.listenBack} &darr;
            </a>
          )}
          {show.data.flyer && (
            <button
              type="button"
              class="show__btn label"
              data-flyer
              data-flyer-src={show.data.flyer.src}
              data-flyer-alt={pick(show.data.flyerAlt, lang) ?? show.data.venue}
              data-flyer-credit={posterArtist(show)?.name ?? ''}
              data-flyer-credit-url={posterArtist(show)?.url ?? ''}
            >
              {t.shows.flyer}
            </button>
          )}
        </div>
      </article>
      );
    })}
  </div>
</section>

<style>
  .shows { padding-block: var(--section-pad); }
  .shows__stack { display: flex; flex-direction: column; gap: 16px; }

  .show {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: 16px;
    padding: 14px;
    align-items: center;
  }

  /* Divider that opens the past group: label, then a rule to the edge —
     the same rule-after-title shape as the section headings. */
  .shows__group {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }

  .shows__group-label { flex: none; }
  .shows__group-rule { flex: 1; height: var(--rule); background: var(--ink); opacity: 0.4; }

  /* Past dates stay on the page but are clearly finished: a dashed frame,
     a greyscale flyer and a PAST stamp. Text keeps full contrast — fading
     the whole card (the old approach) made the copy hard to read. */
  .show--past { border-style: dashed; }
  .show--past .show__flyer,
  .show--past .show__plate { filter: grayscale(1) contrast(1.05); }
  .show--past .show__date { color: var(--ink); }
  .show--past:hover .show__flyer,
  .show--past:hover .show__plate { filter: none; }

  .show__art { width: 150px; position: relative; }

  .show__stamp {
    position: absolute;
    z-index: 1;
    top: 10px;
    left: -6px;
    padding: 3px 8px;
    background: var(--deep);
    color: var(--ink-on-deep);
    border: 1px solid var(--ink-on-deep);
    transform: rotate(-6deg);
    pointer-events: none;
  }
  .show__flyer-btn { display: block; width: 100%; padding: 0; cursor: zoom-in; }
  .show__flyer { width: 150px; height: 186px; object-fit: cover; border-width: 1px; }
  /* Non-portrait artwork (e.g. a square logo) keeps its own proportions. */
  .show__flyer--contain { height: auto; object-fit: contain; }

  .show__plate {
    position: relative;
    overflow: hidden;
    width: 150px;
    height: 186px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 10px;
  }

  /* Same recipe as the hero's green tile: luminosity keeps the photo in the
     plate's own hue, held well back so black ink still reads over it. */
  .show__plate-bg {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 26%;
    filter: grayscale(1) contrast(2.6) brightness(0.92);
    mix-blend-mode: luminosity;
    opacity: 0.32;
  }

  .show__plate-date,
  .show__plate-city { position: relative; }

  .show__plate-date { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; }
  .show__plate-city { font-size: 40px; }

  .show__date {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .show__venue { font-size: 34px; margin: 4px 0 6px; }
  .show__meta { font-size: 12px; line-height: 1.5; }

  .show__actions { display: flex; flex-direction: column; gap: 8px; }

  .show__btn {
    border: var(--rule) solid var(--ink);
    padding: 10px 14px;
    text-align: center;
    min-height: var(--tap);
    display: grid;
    place-items: center;
  }

  .show__btn--fill { background: var(--ink); color: var(--paper); }
  .show__btn:hover { background: var(--accent); color: var(--ink-on-plate); }

  @media (max-width: 780px) {
    .show { grid-template-columns: 1fr; gap: 12px; }
    .show__art, .show__flyer, .show__plate { width: 100%; }
    /* Already full width on mobile — the image itself doesn't open the lightbox. */
    .show__flyer-btn { cursor: default; }
    .show__flyer, .show__plate { height: auto; aspect-ratio: 150 / 186; }
    .show__flyer--contain { aspect-ratio: auto; }
    .show__venue { font-size: 26px; }
    .show__actions { flex-direction: row; }
    .show__btn { flex: 1; }
  }
</style>
