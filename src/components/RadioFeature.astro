---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/utils';
import { pick } from '../i18n/localized';
import { site } from '../data/site';
import { photographers } from '../data/lineup';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

/* The thumbnails come straight from the gallery collection, so the image,
   alt text and credit have one source of truth. Order here is display order:
   the studio window, the mics, then a mid-conversation shot. */
const THUMB_IDS = ['radio-orange-studio', 'radio-mics', 'radio-standing'] as const;
const gallery = await getCollection('gallery');
const thumbs = THUMB_IDS
  .map((id) => gallery.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

/* Each tilt/offset pair is fixed per slot, so the cluster looks hand-dropped
   but never changes between builds. */
const TILTS = [-5, 3.5, -2];
const DROPS = [0, 12, -4];

/* Credit line lists whoever shot the thumbnails above, de-duplicated. */
const credited = [...new Set(thumbs.map((p) => p.data.credit).filter(Boolean))].map(
  (key) => photographers[key as keyof typeof photographers],
);
---

<aside class="rf plate frame" id="radio" aria-labelledby="radio-title">
  <div class="rf__top">
    <div class="rf__text">
      <p class="label rf__kicker">{t.radio.new} · {t.radio.meta}</p>
      <h3 class="display rf__title" id="radio-title">{t.radio.heading}</h3>
      <p class="rf__body">{t.radio.body}</p>
    </div>

    <div class="rf__thumbs">
      {thumbs.map((p, i) => (
        <figure
          class="rf__thumb frame"
          style={`--tilt:${TILTS[i]}deg;--drop:${DROPS[i]}px;z-index:${i + 1}`}
        >
          <Image
            src={p.data.src}
            alt={pick(p.data.alt, lang)}
            widths={[120, 240, 360]}
            sizes="(min-width: 781px) 124px, 120px"
            class="photo"
          />
        </figure>
      ))}
    </div>
  </div>

  <div class="rf__player frame">
    <iframe
      src={site.radioSession.embedUrl}
      title={t.radio.playerTitle}
      allow="autoplay; encrypted-media"
      loading="lazy"
    ></iframe>
  </div>

  <p class="rf__note">
    <a href={site.radioSession.pageUrl} target="_blank" rel="noopener noreferrer">{t.radio.onCba}</a>
    <span aria-hidden="true"> · </span>
    {t.radio.license}
    {credited.length > 0 && (
      <>
        <span aria-hidden="true"> · </span>
        {t.look.photoBy}:{' '}
        {credited.map((c, i) => (
          <>
            {i > 0 && ' & '}
            <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
          </>
        ))}
      </>
    )}
  </p>
</aside>

<style>
  /* A compact spot-ink card: it has to read as a second, smaller headline
     beside the upcoming show, never as the main event. */
  .rf {
    padding: 14px;
    border-color: var(--ink-on-plate);
    /* Scroll target for the "Listen back" button; clears the sticky header. */
    scroll-margin-top: 80px;
  }

  /* Phone: text first, then the photo strip, stacked. */
  .rf__top {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 14px;
  }

  .rf__kicker { font-size: 10px; line-height: 1.5; }
  .rf__title { font-size: 30px; margin: 2px 0 6px; }
  .rf__body { font-size: 13px; line-height: 1.5; }

  /* Overlapping, tilted thumbnails — a scatter of prints on a studio desk.
     The negative margin overlaps each one onto its neighbour, and later
     ones sit on top (z-index set inline). */
  .rf__thumbs {
    display: flex;
    align-items: flex-start;
    padding: 6px 6px 14px;
  }

  .rf__thumb {
    /* A third of the card, capped: fills a phone's width, never gets huge. */
    --w: min(120px, 31%);
    flex: none;
    width: var(--w);
    margin: 0 0 0 -16px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-color: var(--ink-on-plate);
    border-width: 1px;
    /* A hard offset shadow — the Xerox-print look, not a soft drop shadow. */
    box-shadow: 3px 4px 0 rgba(20, 18, 16, 0.4);
    transform: translateY(var(--drop)) rotate(var(--tilt));
    transition: transform 140ms ease-out;
  }

  .rf__thumb:first-child { margin-left: 0; }

  /* Straighten and lift on hover, like picking a print up off the desk. */
  .rf__thumb:hover {
    transform: translateY(calc(var(--drop) - 4px)) rotate(0deg) scale(1.06);
    z-index: 10 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .rf__thumb { transition: none; }
  }

  .rf__player { border-color: var(--ink-on-plate); overflow: hidden; }

  /* iOS Safari sizes an iframe to its content and ignores width:100%; the
     1px width + min-width:100% trick is the same one the Listen band uses. */
  .rf__player iframe {
    width: 1px;
    min-width: 100%;
    max-width: 100%;
    height: 80px;
    border: 0;
    display: block;
  }

  .rf__note { margin-top: 10px; font-size: 11px; line-height: 1.6; }
  .rf__note a { text-decoration: underline; text-underline-offset: 2px; }

  /* Desktop: text on the left, the photo cluster filling the empty space on
     the right. */
  @media (min-width: 781px) {
    .rf { padding: 18px; }
    .rf__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 32px;
    }
    .rf__title { font-size: 38px; }
    .rf__body { font-size: 14px; max-width: 62ch; }
    .rf__thumbs { padding: 10px 14px 20px; flex: none; }
    .rf__thumb { --w: 124px; margin-left: -22px; }
  }
</style>
