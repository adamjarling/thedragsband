---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Marquee from './Marquee.astro';
import Shows from './Shows.astro';
import RadioFeature from './RadioFeature.astro';
import ListenVideo from './ListenVideo.astro';
import Look from './Look.astro';
import BookingFooter from './BookingFooter.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang; canonicalUrl: string }
const { lang, canonicalUrl } = Astro.props;
const t = useTranslations(lang);

const all = (await getCollection('shows')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);
const now = new Date();
/* Upcoming ascending (soonest first), past descending (most recent first). */
const upcoming = all.filter((s) => s.data.date >= now);
const past = all.filter((s) => s.data.date < now).reverse();
/* The hero bills the next *gig*, so a radio slot landing sooner does not
   displace it — broadcasts still list normally in the Shows section. */
const nextGig = upcoming.find((s) => s.data.type === 'show');

const videos = (await getCollection('videos')).sort(
  (a, b) => a.data.order - b.data.order
);
/* Un-pinned photos keep the collection's own (alphabetical) order. Pinned ones
   are then spliced in at their slot, lowest position first so each index is
   still correct by the time it is used. */
const gallery = await getCollection('gallery');
const photos = gallery.filter((p) => !p.data.position);
gallery
  .filter((p) => p.data.position)
  .sort((a, b) => a.data.position! - b.data.position!)
  .forEach((p) => photos.splice(p.data.position! - 1, 0, p));
---

<BaseLayout
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  canonicalUrl={canonicalUrl}
>
  <a href="#main" class="skip-link">{t.booking.skipToContent}</a>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} next={nextGig} />
    <About lang={lang} />
    <Marquee lang={lang} />
    <Shows lang={lang} upcoming={upcoming} past={past}>
      {/* Sits right under the upcoming gigs, above the past ones: second in
          line, so the next show stays the lead. */}
      <RadioFeature slot="between" lang={lang} />
    </Shows>
    <ListenVideo lang={lang} videos={videos} />
    <Look lang={lang} photos={photos} />
  </main>
  <BookingFooter lang={lang} url={Astro.url} />
</BaseLayout>
