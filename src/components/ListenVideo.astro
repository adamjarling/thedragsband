---
import SectionHead from './SectionHead.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { pick } from '../i18n/localized';
import { site } from '../data/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  videos: CollectionEntry<'videos'>[];
}
const { lang, videos } = Astro.props;
const t = useTranslations(lang);

/* SoundCloud's widget takes the public playlist URL; it resolves it itself. */
const playerSrc =
  'https://w.soundcloud.com/player/?' +
  new URLSearchParams({
    url: site.soundcloudPlaylistUrl,
    color: '#1a1a1a',
    visual: 'false',
    show_comments: 'false',
    show_user: 'true',
    show_reposts: 'false',
    hide_related: 'true',
  }).toString();
---

<section class="lv" id="listen">
  <div class="lv__grid gutter">
    <div>
      <SectionHead title={t.listen.heading} />

      <div class="lv__player frame">
        <iframe
          src={playerSrc}
          title={t.listen.playerTitle}
          allow="autoplay; encrypted-media"
          loading="lazy"
        ></iframe>
      </div>

      <p class="lv__note">
        {t.listen.note}
        <a href={site.soundcloudProfileUrl} target="_blank" rel="noopener noreferrer">{t.listen.onSoundcloud}</a>
      </p>
    </div>

    <div id="video">
      <SectionHead title={t.video.heading} />
      <div class="lv__videos">
        {videos.map((v) => (
          <div class:list={['lv__video', 'frame', v.data.orientation === 'portrait' && 'lv__video--portrait']}>
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.data.youtubeId}`}
              title={pick(v.data.title, lang)}
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        ))}
      </div>
    </div>
  </div>

</section>

<style>
  /* Full-bleed spot-ink band. Ink-on-plate throughout, so the local
     text colour is pinned rather than inherited from the page. */
  .lv {
    background: var(--plate);
    color: var(--ink-on-plate);
    padding-block: var(--section-pad);
  }

  .lv :global(.head__rule) { background: var(--ink-on-plate); }
  .lv :global(.head__title), .lv :global(.head__meta) { color: var(--ink-on-plate); }

  .lv__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  /* Grid items default to min-width:auto, so a track refuses to shrink below
     its content's min-content width — an iframe reports 300px. On a narrow
     phone that pushes the column past the viewport. */
  .lv__grid > * { min-width: 0; }

  .lv__player { border-color: var(--ink-on-plate); height: 300px; overflow: hidden; }

  /* Same iOS iframe-sizing workaround as the video frames below. */
  .lv__player iframe {
    width: 1px;
    min-width: 100%;
    max-width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* SoundCloud's widget has no dark theme, so in dark mode (the default —
     only an explicit data-theme="light" opts out) the iframe is inverted.
     hue-rotate(180deg) undoes the colour shift invert() causes, so the
     artwork keeps roughly its own hues. */
  :global(:root:not([data-theme='light'])) .lv__player iframe {
    filter: invert(1) hue-rotate(180deg);
  }

  .lv__note { margin-top: 14px; font-size: 12px; line-height: 1.5; }
  .lv__note a { text-decoration: underline; text-underline-offset: 2px; }

  .lv__videos { display: flex; flex-direction: column; gap: 12px; align-items: stretch; min-width: 0; }

  .lv__video {
    aspect-ratio: 16 / 9;
    border-color: var(--ink-on-plate);
    min-width: 0;
    /* Belt and braces for the iframe below: whatever it does, it is clipped. */
    overflow: hidden;
  }

  /* iOS Safari sizes an iframe to its CONTENT and ignores `width:100%`, so a
     YouTube embed spills past the frame on an iPhone while looking fine in
     desktop Chrome. `width:1px` with `min-width:100%` is the long-standing
     workaround: the tiny width wins the intrinsic-sizing argument, then
     min-width stretches it back to the container. */
  .lv__video iframe {
    width: 1px;
    min-width: 100%;
    max-width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* A Short at full column width would stand ~890px tall, dwarfing the
     landscape slots beside it. Capping the width keeps it roughly the height
     of the two 16:9 frames stacked, and centres it in the column. */
  .lv__video--portrait {
    aspect-ratio: 9 / 16;
    width: 100%;
    max-width: 300px;
    align-self: center;
  }

  @media (max-width: 780px) {
    .lv__grid { grid-template-columns: 1fr; }
  }
</style>
