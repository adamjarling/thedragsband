---
import SectionHead from './SectionHead.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import VideoItem from './VideoItem.astro';
import { site } from '../data/site';
import { socials } from '../data/lineup';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  videos: CollectionEntry<'videos'>[];
}
const { lang, videos } = Astro.props;
const t = useTranslations(lang);

/* `sub_confirmation=1` makes YouTube open its "Subscribe to this channel?"
   prompt on arrival (for visitors who are signed in), so the button is one
   tap from a subscription. A plain link rather than Google's subscribe widget:
   that widget loads a third-party script, which would undo the point of using
   youtube-nocookie embeds. */
const channelUrl = socials.find((s) => s.name === 'YouTube')!.href;
const subscribeUrl = `${channelUrl}?sub_confirmation=1`;

/* Row 1 pairs the audio player with one featured video; Shorts and any other
   16:9 clips follow in their own full-width rows. Each group keeps the explicit
   `order` from videos.json — only the grouping is automatic. */
const featured =
  videos.find((v) => v.data.featured) ?? videos.find((v) => v.data.orientation !== 'portrait');
const rest = videos.filter((v) => v !== featured);
const shorts = rest.filter((v) => v.data.orientation === 'portrait');
const clips = rest.filter((v) => v.data.orientation !== 'portrait');

/* SoundCloud's widget takes the public track URL; it resolves it itself. */
const playerSrc =
  'https://w.soundcloud.com/player/?' +
  new URLSearchParams({
    url: site.soundcloudTrackUrl,
    color: '#1a1a1a',
    visual: 'false',
    show_comments: 'false',
    show_user: 'true',
    show_reposts: 'false',
    hide_related: 'true',
  }).toString();
---

<section class="lv" id="listen">
  <div class="lv__grid gutter">
    <div>
      <SectionHead title={t.listen.heading} />

      <div class="lv__player frame">
        <iframe
          src={playerSrc}
          title={t.listen.playerTitle}
          allow="autoplay; encrypted-media"
          loading="lazy"
        ></iframe>
      </div>

      <p class="lv__note">
        {t.listen.note}
        <a href={site.soundcloudProfileUrl} target="_blank" rel="noopener noreferrer">{t.listen.onSoundcloud}</a>
      </p>
    </div>

    <div id="video">
      <SectionHead title={t.video.heading} />
      {featured && (
        <div class="lv__featured">
          <VideoItem lang={lang} video={featured} />
        </div>
      )}
    </div>
  </div>

  {(shorts.length > 0 || clips.length > 0) && (
    <div class="lv__more gutter">
      {shorts.length > 0 && (
        <div class="lv__group lv__group--shorts">
          {shorts.map((v) => <VideoItem lang={lang} video={v} />)}
        </div>
      )}
      {clips.length > 0 && (
        <div class="lv__group lv__group--clips">
          {clips.map((v) => <VideoItem lang={lang} video={v} />)}
        </div>
      )}
    </div>
  )}

  <div class="lv__cta gutter">
    <a class="lv__subscribe label" href={subscribeUrl} target="_blank" rel="noopener noreferrer">
      <span aria-hidden="true">▶</span> {t.video.subscribe}
    </a>
  </div>
</section>

<style>
  /* Full-bleed spot-ink band. Ink-on-plate throughout, so the local
     text colour is pinned rather than inherited from the page. */
  .lv {
    background: var(--plate);
    color: var(--ink-on-plate);
    padding-block: var(--section-pad);
  }

  .lv :global(.head__rule) { background: var(--ink-on-plate); }
  .lv :global(.head__title), .lv :global(.head__meta) { color: var(--ink-on-plate); }

  .lv__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  /* Grid items default to min-width:auto, so a track refuses to shrink below
     its content's min-content width — an iframe reports 300px. On a narrow
     phone that pushes the column past the viewport. */
  .lv__grid > * { min-width: 0; }

  .lv__player { border-color: var(--ink-on-plate); height: 166px; overflow: hidden; }

  /* Same iOS iframe-sizing workaround as the video frames below. */
  .lv__player iframe {
    width: 1px;
    min-width: 100%;
    max-width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* SoundCloud's widget has no dark theme, so in dark mode (the default —
     only an explicit data-theme="light" opts out) the iframe is inverted.
     hue-rotate(180deg) undoes the colour shift invert() causes, so the
     artwork keeps roughly its own hues. */
  :global(:root:not([data-theme='light'])) .lv__player iframe {
    filter: invert(1) hue-rotate(180deg);
  }

  .lv__note { margin-top: 14px; font-size: 12px; line-height: 1.5; }
  .lv__note a { text-decoration: underline; text-underline-offset: 2px; }

  /* Rows below the audio/featured pair span the whole section. The 22px gap
     matches .lv__grid, so a half-width clip lines up with the column above it. */
  .lv__more { display: flex; flex-direction: column; gap: 22px; margin-top: 22px; }

  /* `justify-content: center` keeps a short last row (a lone clip, or a fourth
     Short after a row of three) centred rather than hanging off the left. */
  .lv__group { display: flex; flex-wrap: wrap; gap: 22px; justify-content: center; min-width: 0; }

  /* Shorts: up to four across, capped so a lone one is not 800px tall. */
  .lv__group--shorts > :global(.lv__item) { flex: 0 1 calc((100% - 66px) / 4); max-width: 320px; }

  /* Clips: half the row each. One on its own stays half-width and centred. */
  .lv__group--clips > :global(.lv__item) { flex: 0 1 calc((100% - 22px) / 2); }

  /* A Short chosen as the featured video would be 9:16 across a whole column. */
  .lv__featured > :global(.lv__item--portrait) { max-width: 300px; margin-inline: auto; }

  .lv__cta { margin-top: 22px; display: flex; justify-content: center; }

  /* Light ink on a dark fill. --ink-on-deep is the fixed light colour; the
     page's --plate is a mid green and nearly vanishes on the ink background. */
  .lv__subscribe {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: min(100%, 340px);
    min-height: var(--tap);
    padding: 14px 28px;
    border: var(--rule) solid var(--ink-on-plate);
    background: var(--ink-on-plate);
    color: var(--ink-on-deep);
    text-align: center;
  }
  .lv__subscribe:hover,
  .lv__subscribe:focus-visible { background: transparent; color: var(--ink-on-plate); }

  @media (max-width: 780px) {
    .lv__grid { grid-template-columns: 1fr; }
    /* Narrow screens: one per row. Shorts are capped so one does not stand
       taller than the screen. */
    .lv__group--clips > :global(.lv__item) { flex-basis: 100%; }
    .lv__group--shorts > :global(.lv__item) { flex-basis: 100%; max-width: 300px; }
    .lv__subscribe { width: 100%; }
  }
</style>
